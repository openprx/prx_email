package prx:plugin@0.1.0;

interface log {}
interface config {}
interface kv {}
interface http-outbound {}
interface memory {}
interface events {}

interface tool-exports {
    record tool-spec {
        name: string,
        description: string,
        parameters-schema: string,
    }

    record plugin-result {
        success: bool,
        output: string,
        error: option<string>,
    }

    get-spec: func() -> tool-spec;
    execute: func(args: string) -> plugin-result;
}

world tool {
    import log;
    import config;
    import kv;
    import http-outbound;
    import memory;
    import events;
    export tool-exports;
}
