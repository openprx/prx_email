package prx:plugin@0.1.0;

interface host-calls {
    record host-result {
        success: bool,
        output: string,
        error: option<string>,
    }

    execute-tool: func(tool: string, args: string, allow-network: bool) -> host-result;
}

interface tool-exports {
    record tool-spec {
        name: string,
        description: string,
        parameters-schema: string,
    }

    record plugin-result {
        success: bool,
        output: string,
        error: option<string>,
    }

    get-spec: func() -> tool-spec;
    execute: func(args: string) -> plugin-result;
}

world tool {
    import host-calls;
    export tool-exports;
}
